includeConfig 'boostdm.conf'

params {
	boostdm = boostdm  // get parameters from boostdm.conf
}

env {
    GENOME_BUILD = "hg38"
    // INTOGEN_DATASETS = "/data/bbg/datasets/intogen/output/collaborations/20260324_BLCA_EPorta/intogen_output/highrisk_lowrisk_mibc/20260320/"
    INTOGEN_DATASETS = "/data/bbg/datasets/intogen/output/collaborations/20260505_BLCA_EPorta/highrisk_lowrisk_mibc/20260505/"
    BOOSTDM_DATASETS = "/data/bbg/projects/intogen_plus/containers/datasets_25/boostdm/"
    VEP_SATURATION = env.INTOGEN_DATASETS + "/steps/boostDM/saturation/"
    PIPELINE = "/data/bbg/datasets/boostdm_runs/boostdm-pipeline-bladder-2026/"
    OUTPUT = "/data/bbg/datasets/boostdm_runs/boostdm-pipeline-bladder-2026-output/"
    MAVE_DATA = "/data/bbg/projects/boostdm_analyses/mave_data/"
}

singularity {
	enabled = true
	cacheDir = "/data/bbg/datasets/boostdm_runs/singularity_images/"
        runOptions = "-B " + env.PIPELINE + "/containers_build:/boostdm " + "-B /data/bbg"

}

process {
    cpus = 1
    errorStrategy = 'ignore'
    // stageInMode = 'copy'    
    withLabel: boostdm {container = "file:///${singularity.cacheDir}/boostdm.simg"}
    withLabel: vep {container = "/data/bbg/datasets/vep/homo_sapiens/ensembl-vep_111.0.sif"}
    withLabel: bgreference {container = "file:///${singularity.cacheDir}/bgreference_latest.sif"}
}

profiles {
    bbglab {
        includeConfig 'config/bbglab.conf'
    }
    local {
        includeConfig 'config/local.conf'
    }
}

timeline {
  enabled = true
}

trace {
  enabled = true
  fields = 'process,task_id,hash,name,attempt,status,exit,realtime,%cpu,vmem,rss,submit,start,complete,duration,realtime,rchar,wchar'
}

